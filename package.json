{
  "name": "shared-expense",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "NEXT_PUBLIC_API_BASE_URL=http://localhost:8787 NEXT_PUBLIC_DEV_ID_TOKEN=local-dev pnpm --parallel --filter @shared-expense/api --filter @shared-expense/web dev",
    "build": "pnpm -r build",
    "deploy:api": "pnpm --filter @shared-expense/api run deploy",
    "deploy:jobs": "pnpm --filter @shared-expense/jobs run deploy",
    "deploy:web": "pnpm --filter @shared-expense/web run pages:deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
